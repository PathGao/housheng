<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list><item android:width="32dp" android:height="32dp"><shape><solid android:color="@android:color/transparent"/></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"><shape android:shape="oval"><solid android:color="@color/housheng_on_primary"/></shape></item></layer-list>
    </item>
    <item>
        <layer-list><item android:width="32dp" android:height="32dp"><shape><solid android:color="@android:color/transparent"/></shape></item>
            <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp"><shape android:shape="oval"><solid android:color="@color/housheng_outline"/></shape></item></layer-list>
    </item>
</selector>
